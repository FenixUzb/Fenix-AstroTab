{
  "manifest_version": 3,
  "name": "ChatGPT New Tab",
  "version": "1.2.0",
  "description": "Новая вкладка с быстрым запросом в ChatGPT + контекстное меню вставки. Без prompt/Alt+N.",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-chatgpt": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Открыть ChatGPT"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
